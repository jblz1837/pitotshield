# Public, browser-visible configuration. Never put a password or private API token here.
# GA4 Measurement ID from the current production source; add to production deployment only after verification.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GH3FLHMFLH
# EmailJS sender: the original site uses service_dw49i0o / template_ifsa9jp for its newsletter only.
# The NEW sales inquiry form needs a confirmed EmailJS template supporting these params:
# from_name, from_email, reply_to, company, aircraft, interest, message
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
